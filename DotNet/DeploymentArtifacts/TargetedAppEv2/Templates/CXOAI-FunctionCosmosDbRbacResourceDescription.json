              "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
              "apiVersion": "2020-06-01-preview",
              "name": "[format('{0}/{1}', parameters('PcosmosDbAccountName'), guid(format('{0}-{1}-{2}', variables('functionPrincipleId'), parameters('PfunctionName'), parameters('PcosmosDbDataRoleIds')[range(0, length(parameters('PcosmosDbDataRoleIds')))[copyIndex()]])))]",
              "properties": {
                "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/{1}', parameters('PcosmosDbAccountResourceId'), parameters('PcosmosDbDataRoleIds')[range(0, length(parameters('PcosmosDbDataRoleIds')))[copyIndex()]])]",
                "principalId": "[variables('functionPrincipleId')]",
                "scope": "[parameters('PcosmosDbAccountResourceId')]"
              }
            },
            {
              "copy": {
