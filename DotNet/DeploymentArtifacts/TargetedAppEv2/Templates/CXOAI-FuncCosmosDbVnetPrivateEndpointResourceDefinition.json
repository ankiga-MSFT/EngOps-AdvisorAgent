{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "5052714797787427566"
    }
  },
  "parameters": {
    "PCosmosDbAccountResourceId": {
      "type": "string"
    },
    "PvnetName": {
      "type": "string"
    },
    "PfunctionName": {
      "type": "string"
    },
    "PdeployInfra": {
      "type": "string"
    },
    "PdeployCosmosResources": {
      "type": "string"
    }
  },
  "variables": {
    "deployInfra": "[bool(parameters('PdeployInfra'))]",
    "deployCosmosResources": "[bool(parameters('PdeployCosmosResources'))]",
    "CosmosDbAccountName": "[split(parameters('PCosmosDbAccountResourceId'), '/')[8]]",
    "PprivateEndpointStorageSubnetName": "storage",
    "PprivateCosmosDnsZoneName": "privatelink.documents.azure.com",
    "PprivateEndpointCosmosName": "[format('{0}.{1}-endpoint', replace(variables('CosmosDbAccountName'), '-', ''), replace(parameters('PfunctionName'), '-', ''))]",
    "Plocation": "[resourceGroup().location]"
  },
  "resources": [
    {
      "condition": "[and(variables('deployCosmosResources'), variables('deployInfra'))]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('PprivateCosmosDnsZoneName')]",
      "location": "global"
    },
    {
      "condition": "[and(variables('deployCosmosResources'), variables('deployInfra'))]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('PprivateCosmosDnsZoneName'), format('{0}-Link', parameters('PvnetName')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('PvnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateCosmosDnsZoneName'))]"
      ]
    },
    {
      "condition": "[and(variables('deployCosmosResources'), variables('deployInfra'))]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2022-05-01",
      "name": "[variables('PprivateEndpointCosmosName')]",
      "location": "[variables('Plocation')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('PvnetName'), variables('PprivateEndpointStorageSubnetName'))]"
        },
        "customNetworkInterfaceName": "[format('{0}-nic', variables('PprivateEndpointCosmosName'))]",
        "privateLinkServiceConnections": [
          {
            "name": "[variables('PprivateEndpointCosmosName')]",
            "properties": {
              "privateLinkServiceId": "[parameters('PCosmosDbAccountResourceId')]",
              "groupIds": [
                "sql"
              ]
            }
          }
        ]
      }
    },
    {
      "condition": "[and(variables('deployCosmosResources'), variables('deployInfra'))]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2022-05-01",
      "name": "[format('{0}/{1}', variables('PprivateEndpointCosmosName'), format('{0}-dns', variables('PprivateEndpointCosmosName')))]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "[variables('PprivateCosmosDnsZoneName')]",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateCosmosDnsZoneName'))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateCosmosDnsZoneName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('PprivateCosmosDnsZoneName'), format('{0}-Link', parameters('PvnetName')))]",
        "[resourceId('Microsoft.Network/privateEndpoints', variables('PprivateEndpointCosmosName'))]"
      ]
    }
  ]
}