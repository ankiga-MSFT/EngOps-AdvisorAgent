            "value": "[parameters('PmuiResourceId')]"
          },
          "Pps_command": {
            "value": "[format('Set-AzContext -SubscriptionId {0} \n Start-AzWebAppSlot -ResourceGroupName {1} -Name {2} -Slot staging', variables('subscriptionId'), parameters('PstorageAccountRGroupName'), parameters('PfunctionName'))]"
          },
          "PScriptId": {
