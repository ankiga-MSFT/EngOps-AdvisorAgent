{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.34.44.8038",
      "templateHash": "580096076209994788"
    }
  },
  "parameters": {
    "PnatGatewayName": {
      "type": "string"
    },
    "PpublicIpName": {
      "type": "string"
    },
    "PnumberOfPublicIPs": {
      "type": "string"
    },
    "PoutboundServiceTag": {
      "type": "array"
    }
  },
  "variables": {
    "location": "[resourceGroup().location]",
    "vnumberOfPublicIPs": "[int(parameters('PnumberOfPublicIPs'))]"
  },
  "resources": [
    {
      "copy": {
        "name": "PpublicIpName_publicIpAddressesCopy",
        "count": "[length(range(0, variables('vnumberOfPublicIPs')))]"
      },
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-07-01",
      "name": "[format('{0}{1}', parameters('PpublicIpName'), range(0, variables('vnumberOfPublicIPs'))[copyIndex()])]",
      "location": "[variables('location')]",
      "properties": {
        "publicIPAllocationMethod": "Static",
        "ipTags": "[parameters('PoutboundServiceTag')]"
      },
      "sku": {
        "name": "Standard"
      }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2024-07-01",
      "name": "[parameters('PnatGatewayName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "copy": [
          {
            "name": "publicIpAddresses",
            "count": "[length(range(0, variables('vnumberOfPublicIPs')))]",
            "input": {
              "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}{1}', parameters('PpublicIpName'), range(0, variables('vnumberOfPublicIPs'))[copyIndex('publicIpAddresses')]))]"
            }
          }
        ],
        "idleTimeoutInMinutes": 4
      },
      "dependsOn": [
        "PpublicIpName_publicIpAddressesCopy"
      ]
    }
  ],
  "outputs": {
    "natGatewayId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/natGateways', parameters('PnatGatewayName'))]"
    }
  }
}