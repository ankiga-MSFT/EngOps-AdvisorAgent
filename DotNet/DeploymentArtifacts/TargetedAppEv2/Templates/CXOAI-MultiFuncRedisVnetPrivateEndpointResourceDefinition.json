              "type": "array"
            },
            "PmuiResourceId": {
              "type": "string"
            }
          },
          "variables": {
            "formattedArray": "[replace(replace(replace(string(json(string(parameters('PredisCacheNames')))), '[', '@('), ']', ')'), '\"', '''')]",
            "scriptVariables": "[format(' $redisCacheNames = {0} \n  ', variables('formattedArray'))]",
            "mainScript": " \r\ntry {\r\n      if ($RedisCacheNames.Length -gt 1) {\r\n        $PrimaryRedisCache = $RedisCacheNames[0]\r\n        $SecondaryRedisCaches = $RedisCacheNames[1..($RedisCacheNames.Length - 1)]\r\n        \r\n        # Link secondary Redis caches to primary\r\n        foreach ($SecondaryRedisCache in $SecondaryRedisCaches) {\r\n            Write-Output \"Linking $SecondaryRedisCache to $PrimaryRedisCache\"\r\n            New-AzRedisCacheLink  -PrimaryServerName $PrimaryRedisCache -SecondaryServerName $SecondaryRedisCache \r\n        }\r\n      }\r\n      else {\r\n        Write-Output \"Only one Redis cache in the array. Skipping linking.\"\r\n      }\r\n} \r\ncatch {\r\nWrite-Error \"An error occurred: $_\"\r\nthrow $_\r\n}\r\n",
            "script": "[format('{0}{1}', variables('scriptVariables'), variables('mainScript'))]",
            "scriptId": "LinkRedisClusters"
          },
          "resources": [
            {
              "type": "Microsoft.Resources/deployments",
              "apiVersion": "2022-09-01",
              "name": "[variables('scriptId')]",
              "properties": {
                "expressionEvaluationOptions": {
                  "scope": "inner"
                },
                "mode": "Incremental",
                "parameters": {
                  "Pps_command": {
                    "value": "[variables('script')]"
                  },
                  "PmuiResourceId": {
                    "value": "[parameters('PmuiResourceId')]"
                  },
                  "PScriptId": {
                    "value": "[variables('scriptId')]"
                  }
                },
                "template": {
                  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                  "contentVersion": "1.0.0.0",
                  "metadata": {
