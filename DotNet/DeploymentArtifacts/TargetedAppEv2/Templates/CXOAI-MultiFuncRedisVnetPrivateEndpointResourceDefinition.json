          },
          "PvnetName": {
            "value": "[parameters('PvnetName')]"
          },
          "PfunctionName": {
            "value": "[parameters('PfunctionName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "92293430854259233"
            }
          },
          "parameters": {
            "PredisAccountId": {
              "type": "string"
            },
            "PvnetName": {
              "type": "string"
            },
            "PfunctionName": {
              "type": "string"
            }
          },
          "variables": {
            "redisAccountName": "[split(parameters('PredisAccountId'), '/')[8]]",
            "PprivateEndpointRedisSubnetName": "storage",
            "PprivateRedisDnsZoneName": "privatelink.redis.cache.azure.net",
            "PprivateEndpointRedisName": "[format('{0}.{1}-endpoint', replace(variables('redisAccountName'), '-', ''), replace(parameters('PfunctionName'), '-', ''))]",
            "Plocation": "[resourceGroup().location]",
            "cnameRecordName": "[format('privatelink.{0}', variables('redisAccountName'))]",
            "cnameRecordAlias": "[format('{0}.privatelink.redis.cache.azure.net', variables('redisAccountName'))]",
            "ttl": 86400
          },
          "resources": [
            {
              "type": "Microsoft.Network/privateDnsZones",
              "apiVersion": "2020-06-01",
              "name": "[variables('PprivateRedisDnsZoneName')]",
              "location": "global"
            },
            {
              "type": "Microsoft.Network/privateDnsZones/CNAME",
              "apiVersion": "2020-06-01",
              "name": "[format('{0}/{1}', variables('PprivateRedisDnsZoneName'), variables('cnameRecordName'))]",
              "properties": {
                "ttl": "[variables('ttl')]",
                "cnameRecord": {
                  "cname": "[variables('cnameRecordAlias')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateRedisDnsZoneName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
              "apiVersion": "2020-06-01",
              "name": "[format('{0}/{1}', variables('PprivateRedisDnsZoneName'), format('{0}-link', parameters('PvnetName')))]",
              "location": "global",
              "properties": {
                "registrationEnabled": false,
                "virtualNetwork": {
                  "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('PvnetName'))]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateRedisDnsZoneName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/privateEndpoints",
              "apiVersion": "2022-05-01",
              "name": "[variables('PprivateEndpointRedisName')]",
              "location": "[variables('Plocation')]",
              "properties": {
                "subnet": {
                  "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('PvnetName'), variables('PprivateEndpointRedisSubnetName'))]"
                },
                "customNetworkInterfaceName": "[format('{0}-nic', variables('PprivateEndpointRedisName'))]",
                "privateLinkServiceConnections": [
                  {
                    "name": "[variables('PprivateEndpointRedisName')]",
                    "properties": {
                      "privateLinkServiceId": "[parameters('PredisAccountId')]",
                      "groupIds": [
                        "redisCache"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
              "apiVersion": "2022-05-01",
              "name": "[format('{0}/{1}', variables('PprivateEndpointRedisName'), 'default')]",
              "properties": {
                "privateDnsZoneConfigs": [
                  {
                    "name": "privatelink-database-windows-net",
                    "properties": {
                      "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateRedisDnsZoneName'))]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateEndpoints', variables('PprivateEndpointRedisName'))]",
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateRedisDnsZoneName'))]",
                "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('PprivateRedisDnsZoneName'), format('{0}-link', parameters('PvnetName')))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'RedisUnLinkedResourceDefination')]"
      ]
    },
    {
      "condition": "[and(variables('deployRedisPrivateEndpoints'), variables('deployInfra'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "RedisLinkedResourceDefination",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "PmuiResourceId": {
            "value": "[parameters('PredismuiResourceId')]"
          },
          "PredisCacheNames": {
            "value": "[variables('PredisCacheNames')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "5284320764998668811"
            }
          },
