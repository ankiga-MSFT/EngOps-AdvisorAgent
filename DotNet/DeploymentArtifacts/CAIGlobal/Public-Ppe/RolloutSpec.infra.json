{
  "$schema": "https://ev2schema.azure.net/schemas/2020-04-01/RegionAgnosticRolloutSpecification.json",
  "contentVersion": "1.0.0",
  "rolloutMetadata": {
    "serviceModelPath": "Public-Ppe/ServiceModel.infra.json",
    "scopeBindingsPath": "Public-Ppe/ScopeBindings.infra.test.json",
    "configuration": {
      "serviceGroupScope": {
        "specPath": "Public-Ppe/ConfigurationSpecification.infra.json"
      }
    },
    "name": "CAIGLOBAL-INFRA - Complete Rollout",
    "rolloutType": "major",
    "buildSource": {
      "parameters": {
        "versionFile": "version.txt"
      }
    },
    "notification": {
      "email": {
        "to": "duvenkatteam@microsoft.com"
      }
    }
