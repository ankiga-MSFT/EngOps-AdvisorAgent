{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.34.44.8038",
      "templateHash": "3540263164909835224"
    }
  },
  "parameters": {
    "PkustoDataConnectionsMappings": {
      "type": "array"
    },
    "PdeployKustoDataConnection": {
      "type": "string"
    },
    "PkustoClusterResourceId": {
      "type": "string"
    }
  },
  "variables": {
    "deployKustoDataConnection": "[bool(parameters('PdeployKustoDataConnection'))]",
    "jsonArray": "[parameters('PkustoDataConnectionsMappings')]",
    "subscriptionId": "[if(variables('deployKustoDataConnection'), split(parameters('PkustoClusterResourceId'), '/')[2], '')]",
    "resourceGroupName": "[if(variables('deployKustoDataConnection'), split(parameters('PkustoClusterResourceId'), '/')[4], '')]",
    "clusterName": "[if(variables('deployKustoDataConnection'), split(parameters('PkustoClusterResourceId'), '/')[8], '')]"
  },
  "resources": [
    {
      "copy": {
        "name": "ScopedKustoDataConnections",
        "count": "[length(variables('jsonArray'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "condition": "[variables('deployKustoDataConnection')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('ScopedKustoDataConnections-{0}', copyIndex())]",
      "subscriptionId": "[variables('subscriptionId')]",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "PKustoClusterName": {
            "value": "[variables('clusterName')]"
          },
          "pkustoDataConnectionMapping": {
            "value": "[variables('jsonArray')[copyIndex()]]"
          },
          "PkustoResourceId": {
            "value": "[parameters('PkustoClusterResourceId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.34.44.8038",
              "templateHash": "7725525157293535793"
            }
          },
          "parameters": {
            "PKustoClusterName": {
              "type": "string"
            },
            "PkustoResourceId": {
              "type": "string"
            },
            "pkustoDataConnectionMapping": {
              "type": "object"
            }
          },
          "variables": {
            "obj": "[parameters('pkustoDataConnectionMapping')]"
          },
          "resources": [
            {
              "condition": "[equals(variables('obj').kustoConnectionKind, 'CosmosDb')]",
              "type": "Microsoft.Kusto/clusters/databases/dataConnections",
              "apiVersion": "2024-04-13",
              "name": "[format('{0}/{1}/{2}', parameters('PKustoClusterName'), variables('obj').kustoDatabaseName, variables('obj').kustoDataConnectionName)]",
              "location": "West US 3",
              "kind": "[variables('obj').kustoConnectionKind]",
              "properties": {
                "cosmosDbAccountResourceId": "[variables('obj').cosmosDbAccountResourceId]",
                "cosmosDbContainer": "[variables('obj').cosmosDbContainer]",
                "cosmosDbDatabase": "[variables('obj').cosmosDbDatabase]",
                "managedIdentityResourceId": "[parameters('PkustoResourceId')]",
                "mappingRuleName": "[variables('obj').mappingRuleName]",
                "retrievalStartDate": "[variables('obj').retrievalStartDate]",
                "tableName": "[variables('obj').tableName]"
              }
            },
            {
              "condition": "[equals(variables('obj').kustoConnectionKind, 'EventHub')]",
              "type": "Microsoft.Kusto/clusters/databases/dataConnections",
              "apiVersion": "2024-04-13",
              "name": "[format('{0}/{1}/{2}', parameters('PKustoClusterName'), variables('obj').kustoDatabaseName, variables('obj').kustoDataConnectionName)]",
              "location": "West US 3",
              "kind": "[variables('obj').kustoConnectionKind]",
              "properties": {
                "consumerGroup": "[variables('obj').eventhubConsumerGroup]",
                "dataFormat": "MULTIJSON",
                "eventHubResourceId": "[variables('obj').eventHubResourceId]",
                "managedIdentityResourceId": "[parameters('PkustoResourceId')]",
                "mappingRuleName": "[variables('obj').mappingRuleName]",
                "retrievalStartDate": "[variables('obj').retrievalStartDate]",
                "tableName": "[variables('obj').tableName]"
              }
            }
          ]
        }
      }
    }
  ]
}