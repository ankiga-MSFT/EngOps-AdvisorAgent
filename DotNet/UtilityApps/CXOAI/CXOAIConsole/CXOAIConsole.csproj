<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>CXOAI</RootNamespace>
		<AssemblyName>CXOAIConsole</AssemblyName>
		<UserSecretsId>a2b5a2b5-3d99-410a-bc67-6c425da5d05c</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
		<PackageReference Include="Azure.Identity" Version="1.18.0" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-rc3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Common\Services\Middleware\Middleware.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\SkillFramework\SkillFramework.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\AppServices\CXOAI.AppServices\AppServices.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\ConfigurationStoreService\ConfigurationStoreService.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\ConversationStoreService\ConversationStoreService.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\MemoryService\MemoryService.csproj" />
		<ProjectReference Include="..\..\..\Common\Services\StatusNotifierService\StatusNotifierService.csproj" />
		<ProjectReference Include="..\..\..\Tools\CXOAI\CXOAIToolsService.csproj" />
		<ProjectReference Include="..\..\..\Common\Providers\Provider\Providers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Seeds\aspect_knowledge_seed.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Content Include="..\..\..\Functions\CXOAI\EnvironmentSettings\*.json" Link="EnvironmentSettings\%(Filename)%(Extension)">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\..\Common\Services\ConfigurationStoreService\StoreConfigs\test.SeedData.json" Link="StoreConfigs\test.SeedData.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="EnvironmentSettings\" />
	</ItemGroup>

</Project>
