{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "14449604997323648748"
    }
  },
  "parameters": {
    "PkeyVaultAccountId": {
      "type": "string"
    },
    "PvnetName": {
      "type": "string"
    },
    "PfunctionName": {
      "type": "string"
    },
    "PdeployInfra": {
      "type": "string"
    }
  },
  "variables": {
    "deployInfra": "[bool(parameters('PdeployInfra'))]",
    "keyVaultAccountName": "[split(parameters('PkeyVaultAccountId'), '/')[8]]",
    "PprivateEndpointkeyVaultSubnetName": "storage",
    "PprivatekeyVaultDnsZoneName": "privatelink.vaultcore.azure.net",
    "PprivateEndpointkeyVaultName": "[format('{0}.{1}-endpoint', replace(variables('keyVaultAccountName'), '-', ''), replace(parameters('PfunctionName'), '-', ''))]",
    "Plocation": "[resourceGroup().location]"
  },
  "resources": [
    {
      "condition": "[variables('deployInfra')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('PprivatekeyVaultDnsZoneName')]",
      "location": "global"
    },
    {
      "condition": "[variables('deployInfra')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('PprivatekeyVaultDnsZoneName'), format('{0}-link', parameters('PvnetName')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('PvnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivatekeyVaultDnsZoneName'))]"
      ]
    },
    {
      "condition": "[variables('deployInfra')]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2022-05-01",
      "name": "[variables('PprivateEndpointkeyVaultName')]",
      "location": "[variables('Plocation')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('PvnetName'), variables('PprivateEndpointkeyVaultSubnetName'))]"
        },
        "customNetworkInterfaceName": "[format('{0}-nic', variables('PprivateEndpointkeyVaultName'))]",
        "privateLinkServiceConnections": [
          {
            "name": "[variables('PprivateEndpointkeyVaultName')]",
            "properties": {
              "privateLinkServiceId": "[parameters('PkeyVaultAccountId')]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ]
      }
    },
    {
      "condition": "[variables('deployInfra')]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2022-05-01",
      "name": "[format('{0}/{1}', variables('PprivateEndpointkeyVaultName'), format('{0}-dns', variables('PprivateEndpointkeyVaultName')))]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "[variables('PprivatekeyVaultDnsZoneName')]",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivatekeyVaultDnsZoneName'))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', variables('PprivateEndpointkeyVaultName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivatekeyVaultDnsZoneName'))]"
      ]
    }
  ]
}