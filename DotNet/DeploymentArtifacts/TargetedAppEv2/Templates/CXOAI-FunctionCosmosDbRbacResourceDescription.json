              "properties": {
                "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/{1}', parameters('PcosmosDbAccountResourceId'), parameters('PcosmosDbDataRoleIds')[range(0, length(parameters('PcosmosDbDataRoleIds')))[copyIndex()]])]",
