{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "4134169607989998512"
    }
  },
  "parameters": {
    "PvnetName": {
      "type": "string"
    },
    "PfunctionName": {
      "type": "string"
    },
    "PsearchServiceIds": {
      "type": "array"
    },
    "PdeployInfra": {
      "type": "string"
    },
    "PdeploySearchServiceResources": {
      "type": "string"
    }
  },
  "variables": {
    "deployInfra": "[bool(parameters('PdeployInfra'))]",
    "deploySearchResources": "[bool(parameters('PdeploySearchServiceResources'))]"
  },
  "resources": [
    {
      "copy": {
        "name": "multiPrivateEndpointSearchServiceToFunc",
        "count": "[length(parameters('PsearchServiceIds'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "condition": "[and(variables('deploySearchResources'), variables('deployInfra'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('pe-search-{0}', guid(parameters('PsearchServiceIds')[copyIndex()], parameters('PvnetName'), parameters('PfunctionName')))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "PsearchServiceId": {
            "value": "[parameters('PsearchServiceIds')[copyIndex()]]"
          },
          "PvnetName": {
            "value": "[parameters('PvnetName')]"
          },
          "PfunctionName": {
            "value": "[parameters('PfunctionName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "11310744804740752063"
            }
          },
          "parameters": {
            "PsearchServiceId": {
              "type": "string"
            },
            "PvnetName": {
              "type": "string"
            },
            "PfunctionName": {
              "type": "string"
            }
          },
          "variables": {
            "searchServiceName": "[split(parameters('PsearchServiceId'), '/')[8]]",
            "PprivateEndpointSearchSubnetName": "storage",
            "PprivateSearchDnsZoneName": "privatelink.search.windows.net",
            "PprivateEndpointSearchName": "[format('{0}.{1}-endpoint', replace(variables('searchServiceName'), '-', ''), replace(parameters('PfunctionName'), '-', ''))]",
            "Plocation": "[resourceGroup().location]",
            "cnameRecordName": "[format('privatelink.{0}', variables('searchServiceName'))]",
            "cnameRecordAlias": "[format('{0}.privatelink.search.windows.net', variables('searchServiceName'))]",
            "ttl": 86400
          },
          "resources": [
            {
              "type": "Microsoft.Network/privateDnsZones",
              "apiVersion": "2020-06-01",
              "name": "[variables('PprivateSearchDnsZoneName')]",
              "location": "global"
            },
            {
              "type": "Microsoft.Network/privateDnsZones/CNAME",
              "apiVersion": "2020-06-01",
              "name": "[format('{0}/{1}', variables('PprivateSearchDnsZoneName'), variables('cnameRecordName'))]",
              "properties": {
                "ttl": "[variables('ttl')]",
                "cnameRecord": {
                  "cname": "[variables('cnameRecordAlias')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateSearchDnsZoneName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
              "apiVersion": "2020-06-01",
              "name": "[format('{0}/{1}', variables('PprivateSearchDnsZoneName'), format('{0}-link', parameters('PvnetName')))]",
              "location": "global",
              "properties": {
                "registrationEnabled": false,
                "virtualNetwork": {
                  "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('PvnetName'))]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateSearchDnsZoneName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/privateEndpoints",
              "apiVersion": "2022-05-01",
              "name": "[variables('PprivateEndpointSearchName')]",
              "location": "[variables('Plocation')]",
              "properties": {
                "subnet": {
                  "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('PvnetName'), variables('PprivateEndpointSearchSubnetName'))]"
                },
                "customNetworkInterfaceName": "[format('{0}-nic', variables('PprivateEndpointSearchName'))]",
                "privateLinkServiceConnections": [
                  {
                    "name": "[variables('PprivateEndpointSearchName')]",
                    "properties": {
                      "privateLinkServiceId": "[parameters('PsearchServiceId')]",
                      "groupIds": [
                        "searchService"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
              "apiVersion": "2022-05-01",
              "name": "[format('{0}/{1}', variables('PprivateEndpointSearchName'), format('{0}-dns', variables('PprivateEndpointSearchName')))]",
              "properties": {
                "privateDnsZoneConfigs": [
                  {
                    "name": "[variables('PprivateSearchDnsZoneName')]",
                    "properties": {
                      "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateSearchDnsZoneName'))]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateEndpoints', variables('PprivateEndpointSearchName'))]",
                "[resourceId('Microsoft.Network/privateDnsZones', variables('PprivateSearchDnsZoneName'))]",
                "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('PprivateSearchDnsZoneName'), format('{0}-link', parameters('PvnetName')))]"
              ]
            }
          ]
        }
      }
    }
  ]
}